<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:FirstMauiApp.ViewModels"
             x:Class="FirstMauiApp.Views.BudgetsPage"
             x:DataType="viewmodels:BudgetsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <!-- Month Selector -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="&lt;" Command="{Binding PreviousMonthCommand}" WidthRequest="44" HeightRequest="44" CornerRadius="22" />
                <Label Text="{Binding MonthYearDisplay}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" HorizontalOptions="Center" />
                <Button Text="&gt;" Command="{Binding NextMonthCommand}" WidthRequest="44" HeightRequest="44" CornerRadius="22" />
            </HorizontalStackLayout>

            <!-- Budgets List -->
            <CollectionView ItemsSource="{Binding BudgetItems}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:BudgetItem">
                        <Border StrokeShape="RoundRectangle 12" Stroke="LightGray" Padding="14" Margin="0,4,0,8">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding CategoryDisplay}" FontSize="16" FontAttributes="Bold" />
                                    <Label Grid.Column="1" Text="{Binding FormattedSpent}" FontSize="14" />
                                </Grid>
                                <ProgressBar Progress="{Binding Progress}" ProgressColor="{Binding ProgressColor}" HeightRequest="8" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="{Binding FormattedRemaining, StringFormat='Remaining: {0}'}" FontSize="12" TextColor="Gray" />
                                    <Label Grid.Column="1" Text="{Binding FormattedLimit, StringFormat='Budget: {0}'}" FontSize="12" TextColor="Gray" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button Grid.Column="0" Text="Set / Edit Budget"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BudgetsViewModel}}, Path=SetBudgetCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="36" FontSize="12" CornerRadius="8" />
                                    <Button Grid.Column="1" Text="Remove"
                                            IsVisible="{Binding HasBudget}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BudgetsViewModel}}, Path=RemoveBudgetCommand}"
                                            CommandParameter="{Binding .}"
                                            HeightRequest="36" FontSize="12" CornerRadius="8"
                                            BackgroundColor="#C62828" TextColor="White" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
